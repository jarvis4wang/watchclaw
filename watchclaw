#!/usr/bin/env bash
# watchclaw — OpenClaw Gateway Watchdog CLI
# A companion that watches your claw.
set -uo pipefail

VERSION="0.1.0"
SOURCE="$0"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

# ── Config resolution ────────────────────────────────────────────────
absolute_path() {
  local path="$1"
  if [[ "$path" == /* ]]; then
    echo "$path"
  else
    echo "$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
  fi
}

xml_escape() {
  local value="$1"
  value=${value//&/&amp;}
  value=${value//</&lt;}
  value=${value//>/&gt;}
  echo "$value"
}

cli_path() {
  absolute_path "$SOURCE"
}

resolve_conf() {
  if [[ -n "${OPT_CONFIG:-}" && -f "$OPT_CONFIG" ]]; then
    echo "$OPT_CONFIG"
  elif [[ -n "${WATCHCLAW_CONF:-}" && -f "$WATCHCLAW_CONF" ]]; then
    echo "$WATCHCLAW_CONF"
  elif [[ -f "$SCRIPT_DIR/watchclaw.conf" ]]; then
    echo "$SCRIPT_DIR/watchclaw.conf"
  elif [[ -f "$HOME/.config/watchclaw/watchclaw.conf" ]]; then
    echo "$HOME/.config/watchclaw/watchclaw.conf"
  else
    echo ""
  fi
}

load_conf() {
  local conf
  conf=$(resolve_conf)
  if [[ -z "$conf" ]]; then
    echo "ERROR: No config found. Create watchclaw.conf from watchclaw.conf.example" >&2
    echo "  Searched: --config, \$WATCHCLAW_CONF, ./watchclaw.conf, ~/.config/watchclaw/watchclaw.conf" >&2
    return 1
  fi
  conf=$(absolute_path "$conf")
  # shellcheck disable=SC1090
  source "$conf"
  RESOLVED_CONF="$conf"
}

# ── Lock / PID helpers ───────────────────────────────────────────────
lock_file() { echo "/tmp/watchclaw-${GATEWAY_PORT}.pid"; }

launchd_label_from_conf() {
  local base
  base="$(basename "$RESOLVED_CONF")"
  base="${base%.conf}"
  base="${base#watchclaw-}"
  [[ -z "$base" || "$base" == "watchclaw" ]] && base="default"
  base="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')"
  base="${base#-}"
  base="${base%-}"
  [[ -z "$base" ]] && base="default"
  echo "com.watchclaw.$base"
}

launchd_plist_path() {
  local label="${1:-$(launchd_label_from_conf)}"
  echo "${WATCHCLAW_LAUNCHAGENT_DIR:-$HOME/Library/LaunchAgents}/${label}.plist"
}

launchd_service_name() {
  local label="${1:-$(launchd_label_from_conf)}"
  local uid
  uid=$(id -u 2>/dev/null || echo "")
  [[ -n "$uid" ]] || return 1
  echo "gui/$uid/$label"
}

write_launchd_plist() {
  local label="$1"
  local plist_path="$2"
  local cli
  cli=$(cli_path)

  mkdir -p "$(dirname "$plist_path")"
  cat > "$plist_path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$cli")</string>
    <string>--config</string>
    <string>$(xml_escape "$RESOLVED_CONF")</string>
    <string>start</string>
    <string>--foreground</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$(xml_escape "${LOG_FILE:-$HOME/.config/watchclaw/watchclaw.log}")</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "${LOG_FILE:-$HOME/.config/watchclaw/watchclaw.log}")</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(xml_escape "${PATH:-/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin}")</string>
  </dict>
  <key>WatchclawManaged</key>
  <true/>
</dict>
</plist>
EOF
}

find_launchd_service() {
  [[ "$(uname -s 2>/dev/null)" == "Darwin" ]] || return 1
  command -v launchctl >/dev/null 2>&1 || return 1

  local uid
  uid=$(id -u 2>/dev/null || echo "")
  [[ -n "$uid" ]] || return 1

  local locations=(
    "${WATCHCLAW_LAUNCHAGENT_DIR:-$HOME/Library/LaunchAgents}:gui/$uid"
    "/Library/LaunchAgents:gui/$uid"
    "/Library/LaunchDaemons:system"
  )

  local location dir domain plist label
  shopt -s nullglob
  for location in "${locations[@]}"; do
    dir="${location%%:*}"
    domain="${location#*:}"
    [[ -d "$dir" ]] || continue

    for plist in "$dir"/*.plist; do
      [[ -f "$plist" ]] || continue
      grep -Fq "<string>$RESOLVED_CONF</string>" "$plist" 2>/dev/null || continue

      label="$(basename "$plist" .plist)"
      launchctl print "$domain/$label" >/dev/null 2>&1 || continue

      printf '%s|%s|%s\n' "$domain" "$label" "$plist"
      shopt -u nullglob
      return 0
    done
  done
  shopt -u nullglob
  return 1
}

launchd_service_pid() {
  local service="$1"
  local pid
  pid=$(launchctl print "$service" 2>/dev/null | sed -n 's/^[[:space:]]*pid = //p' | head -1 | tr -d ' ')
  if [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    echo "$pid"
    return 0
  fi
  return 1
}

is_current_launchd_service() {
  local label="$1"
  [[ -n "${XPC_SERVICE_NAME:-}" ]] || return 1
  [[ "$XPC_SERVICE_NAME" == "$label" ]]
}

start_via_launchd() {
  local label plist_path service pid

  label=$(launchd_label_from_conf)
  plist_path=$(launchd_plist_path "$label")
  service=$(launchd_service_name "$label") || return 1

  write_launchd_plist "$label" "$plist_path"

  launchctl enable "$service" >/dev/null 2>&1 || true
  launchctl bootout "$service" >/dev/null 2>&1 || true
  launchctl bootout "gui/$(id -u)" "$plist_path" >/dev/null 2>&1 || true

  if ! launchctl bootstrap "gui/$(id -u)" "$plist_path" >/dev/null 2>&1; then
    echo "ERROR: Failed to bootstrap launchd service $label" >&2
    return 1
  fi
  launchctl kickstart -k "$service" >/dev/null 2>&1 || true

  sleep 1
  pid=$(running_pid)
  if [[ -n "$pid" ]]; then
    echo "Watchclaw running (launchd: $label, PID $pid). Logs: ${LOG_FILE:-./logs/watchclaw.log}"
    return 0
  fi

  echo "ERROR: Watchclaw failed to start via launchd." >&2
  return 1
}

running_pid() {
  local lf
  lf=$(lock_file)
  if [[ -f "$lf" ]]; then
    local pid
    pid=$(cat "$lf" 2>/dev/null)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return
    fi
  fi

  local launchd_meta launchd_domain launchd_label launchd_pid
  launchd_meta=$(find_launchd_service || true)
  if [[ -n "$launchd_meta" ]]; then
    launchd_domain="${launchd_meta%%|*}"
    launchd_meta="${launchd_meta#*|}"
    launchd_label="${launchd_meta%%|*}"
    if ! is_current_launchd_service "$launchd_label"; then
      launchd_pid=$(launchd_service_pid "${launchd_domain}/${launchd_label}" || true)
    else
      launchd_pid=""
    fi
    if [[ -n "$launchd_pid" ]]; then
      echo "$launchd_pid"
      return
    fi
  fi

  echo ""
}

# ── Commands ─────────────────────────────────────────────────────────

cmd_start() {
  load_conf || exit 1
  local pid
  pid=$(running_pid)
  if [[ -n "$pid" ]]; then
    echo "Watchclaw already running (PID $pid) on port $GATEWAY_PORT"
    exit 1
  fi

  if [[ "${FOREGROUND:-0}" == "1" ]]; then
    echo "Starting watchclaw (foreground) on port $GATEWAY_PORT..."
    export WATCHCLAW_FOREGROUND=1
    exec bash "$SCRIPT_DIR/watchclaw.sh" "$RESOLVED_CONF"
  elif [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
    echo "Starting watchclaw with launchd on port $GATEWAY_PORT..."
    start_via_launchd || exit 1
  else
    echo "Starting watchclaw on port $GATEWAY_PORT..."
    local start_log="/tmp/watchclaw-start-$$.log"
    bash "$SCRIPT_DIR/watchclaw.sh" "$RESOLVED_CONF" </dev/null >"$start_log" 2>&1 &
    disown $! 2>/dev/null
    sleep 1
    pid=$(running_pid)
    if [[ -n "$pid" ]]; then
      echo "Watchclaw running (PID $pid). Logs: ${LOG_FILE:-./logs/watchclaw.log}"
      rm -f "$start_log"
    else
      echo "ERROR: Watchclaw failed to start." >&2
      # Show captured stderr (if any)
      if [[ -s "$start_log" ]]; then
        cat "$start_log" >&2
      fi
      # Show recent log entries for the actual error
      local lf="${LOG_FILE:-./logs/watchclaw.log}"
      if [[ -f "$lf" ]]; then
        echo "" >&2
        tail -5 "$lf" | grep -E '\[(ERROR|WARN)\]' >&2
      fi
      rm -f "$start_log"
      exit 1
    fi
  fi
}

cmd_stop() {
  load_conf || exit 1
  local launchd_service="" launchd_domain="" launchd_label="" launchd_plist=""
  local launchd_meta
  launchd_meta=$(find_launchd_service || true)
  if [[ -n "$launchd_meta" ]]; then
    launchd_domain="${launchd_meta%%|*}"
    launchd_meta="${launchd_meta#*|}"
    launchd_label="${launchd_meta%%|*}"
    launchd_plist="${launchd_meta#*|}"
    launchd_service="${launchd_domain}/${launchd_label}"

    echo "Stopping watchclaw launchd service ($launchd_label)..."
    if ! launchctl bootout "$launchd_service" >/dev/null 2>&1; then
      echo "WARN: launchctl bootout failed for $launchd_label. Falling back to PID stop." >&2
    else
      sleep 1
    fi
    launchctl disable "$launchd_service" >/dev/null 2>&1 || true
  fi

  local pid
  pid=$(running_pid)
  if [[ -z "$pid" ]]; then
    if [[ -n "$launchd_plist" ]]; then
      rm -f "$(lock_file)"
      echo "Stopped."
    else
      echo "Watchclaw is not running on port $GATEWAY_PORT"
    fi
    exit 0
  fi
  echo "Stopping watchclaw (PID $pid)..."
  kill "$pid" 2>/dev/null
  sleep 2
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
  fi
  rm -f "$(lock_file)"
  echo "Stopped."
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start
}

cmd_status() {
  load_conf || exit 1
  local pid
  pid=$(running_pid)
  local supervisor="direct"
  local launchd_meta launchd_label
  launchd_meta=$(find_launchd_service || true)
  if [[ -n "$launchd_meta" ]]; then
    launchd_meta="${launchd_meta#*|}"
    launchd_label="${launchd_meta%%|*}"
    supervisor="launchd ($launchd_label)"
  fi

  echo "Watchclaw: v${VERSION}"
  echo ""

  if [[ -z "$pid" ]]; then
    echo "── Watchclaw ──────────────────────────"
    echo "  State:          STOPPED"
    echo "  Config:         ${RESOLVED_CONF}"
    echo ""
    echo "── Gateway ────────────────────────────"
    echo "  Port:           $GATEWAY_PORT"
    echo "  Gateway conf dir:  $GATEWAY_CONFIG_DIR"
    return
  fi

  # Read state from log (last occurrence)
  local state="UNKNOWN"
  local log_file="${LOG_FILE:-./logs/watchclaw.log}"
  if [[ -f "$log_file" ]]; then
    # Extract latest state transition
    local last_state
    last_state=$(grep -oE 'state=(HEALTHY|PROBATION|ALERT|IDLE|RESTARTING)' "$log_file" | tail -1 | cut -d= -f2)
    [[ -n "$last_state" ]] && state="$last_state"
    # Check for probation/alert patterns if no explicit state=
    if [[ "$state" == "UNKNOWN" ]]; then
      if grep -q "entering PROBATION\|entering probation" "$log_file" 2>/dev/null; then
        state="PROBATION"
      fi
    fi
  fi

  # Uptime
  local start_ts uptime_str=""
  if command -v ps &>/dev/null; then
    local elapsed
    elapsed=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')
    [[ -n "$elapsed" ]] && uptime_str="$elapsed"
  fi

  # Known-good hash
  local kg_hash="(none)"
  if [[ -d "$GATEWAY_CONFIG_DIR/.git" ]]; then
    kg_hash=$(git -C "$GATEWAY_CONFIG_DIR" rev-parse --short "known-good" 2>/dev/null || echo "(none)")
  fi

  # Health check
  local health="UNKNOWN"
  local code
  code=$(curl -s -o /dev/null -w "%{http_code}" --max-time "${HEALTH_TIMEOUT:-5}" \
    "http://127.0.0.1:${GATEWAY_PORT}/" 2>/dev/null) || code="ERR"
  [[ "$code" == "200" ]] && health="200 OK" || health="$code"

  # Retry info from log
  local retries="0/${MAX_RETRIES:-3}"
  local last_retry_num
  last_retry_num=$(grep -oE 'Retry ([0-9]+)/[0-9]+' "$log_file" 2>/dev/null | tail -1 | grep -oE '[0-9]+/[0-9]+')
  [[ -n "$last_retry_num" ]] && retries="$last_retry_num" || retries="0/${MAX_RETRIES:-3}"

  local dry_run_str="False"
  [[ "${DRY_RUN:-0}" == "1" ]] && dry_run_str="True"

  echo "── Watchclaw ──────────────────────────"
  echo "  State:          $state"
  [[ -n "$uptime_str" ]] && echo "  Uptime:         $uptime_str"
  echo "  PID:            $pid"
  echo "  Supervisor:     $supervisor"
  echo "  Config:         $RESOLVED_CONF"
  echo "  Alert hook:     ${ALERT_HOOK:-none}"
  echo "  Dry-run:        $dry_run_str"
  echo "  Retries:        $retries"
  echo ""
  echo "── Gateway ────────────────────────────"
  echo "  Health:         $health"
  echo "  Port:           $GATEWAY_PORT"
  echo "  Known-good commit: $kg_hash"
  echo "  Gateway conf dir:  $GATEWAY_CONFIG_DIR"
}

cmd_logs() {
  load_conf || exit 1
  local log_file="${LOG_FILE:-./logs/watchclaw.log}"
  if [[ ! -f "$log_file" ]]; then
    echo "No log file at $log_file"
    exit 1
  fi
  if [[ "${FOLLOW:-0}" == "1" ]]; then
    tail -f "$log_file"
  else
    tail -n "${TAIL_LINES:-50}" "$log_file"
  fi
}

cmd_config() {
  load_conf || exit 1
  echo "# Resolved config: $RESOLVED_CONF"
  echo ""
  cat "$RESOLVED_CONF"
}

cmd_version() {
  echo "v${VERSION}"
}

cmd_help() {
  cat <<'EOF'
watchclaw — A watchdog companion for your OpenClaw gateway.

Usage:
  watchclaw <command> [options]

Commands:
  start       Start the watchdog daemon
  stop        Stop the watchdog daemon
  restart     Restart the watchdog daemon
  status      Show watchdog and gateway status
  logs        View watchdog logs
  config      Print resolved configuration
  version     Print version
  help        Show this help

Options:
  --config PATH       Path to config file
  --foreground        Run in foreground (start only)
  --follow, -f        Follow log output (logs only)
  --tail N            Number of log lines to show (default: 50)

Config search order:
  1. --config PATH
  2. $WATCHCLAW_CONF
  3. ./watchclaw.conf
  4. ~/.config/watchclaw/watchclaw.conf

Examples:
  watchclaw start                     # Start as daemon
  watchclaw start --foreground        # Run in foreground
  watchclaw status                    # Check status
  watchclaw logs --follow             # Tail logs
  watchclaw stop                      # Stop daemon
EOF
}

# ── Parse args ───────────────────────────────────────────────────────
OPT_CONFIG=""
FOREGROUND=0
FOLLOW=0
TAIL_LINES=50
COMMAND=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)       OPT_CONFIG="$2"; shift 2 ;;
    --foreground)    FOREGROUND=1; shift ;;
    --follow|-f)    FOLLOW=1; shift ;;
    --tail)         TAIL_LINES="$2"; shift 2 ;;
    --version|-V)   cmd_version; exit 0 ;;
    -*)             echo "Unknown option: $1" >&2; cmd_help; exit 1 ;;
    *)
      if [[ -z "$COMMAND" ]]; then
        COMMAND="$1"
      else
        echo "Unexpected argument: $1" >&2; exit 1
      fi
      shift ;;
  esac
done

case "${COMMAND:-help}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  config)  cmd_config ;;
  version) cmd_version ;;
  version|--version|-V) cmd_version ;;
  help|--help|-h) cmd_help ;;
  *)       echo "Unknown command: $COMMAND" >&2; cmd_help; exit 1 ;;
esac
